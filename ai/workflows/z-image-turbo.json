{
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "{{unet}}", "weight_dtype": "default" } },
  "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "{{clip}}", "type": "lumina2" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "{{vae}}" } },
  "4": { "class_type": "LoraLoaderModelOnly", "inputs": { "model": ["1", 0], "lora_name": "{{lora}}", "strength_model": "{{loraStrength}}" } },
  "10": { "class_type": "ModelSamplingAuraFlow", "inputs": { "model": ["4", 0], "shift": "{{shift}}" } },
  "5": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{prompt}}", "clip": ["2", 0] } },
  "11": { "class_type": "ConditioningZeroOut", "inputs": { "conditioning": ["5", 0] } },
  "6": { "class_type": "EmptySD3LatentImage", "inputs": { "width": "{{width}}", "height": "{{height}}", "batch_size": 1 } },
  "7": { "class_type": "KSampler", "inputs": { "model": ["10", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}", "sampler_name": "res_multistep", "scheduler": "simple", "positive": ["5", 0], "negative": ["11", 0], "latent_image": ["6", 0], "denoise": 1 } },
  "8": { "class_type": "VAEDecode", "inputs": { "samples": ["7", 0], "vae": ["3", 0] } },
  "9": { "class_type": "SaveImage", "inputs": { "images": ["8", 0], "filename_prefix": "{{filenamePrefix}}" } }
}
